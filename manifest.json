{
  "schemaVersion": 1,
  "id": "donovan.notification-center",
  "name": "Notification Center",
  "version": "0.2.0",
  "author": "Donovan",
  "description": "Notifications grouped by application, with search, persistent history and Do Not Disturb.",
  "license": "MIT",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Notifications",
    "description": "Notifications grouped by application, with search, persistent history and Do Not Disturb.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "panelWidth": 440,
      "listHeight": 0,
      "badge": "Dot",
      "keepDays": 30,
      "maxItems": 1000,
      "clickAction": "Auto",
      "showBody": true,
      "showPreview": true,
      "collapsed": true
    },
    "schema": [
      {
        "key": "badge",
        "type": "enum",
        "label": "Unread indicator",
        "options": [
          "Dot",
          "Highlight",
          "Count",
          "None"
        ],
        "defaultValue": "Dot"
      },
      {
        "key": "keepDays",
        "type": "integer",
        "label": "History retention (days)",
        "min": 1,
        "max": 365,
        "step": 1,
        "defaultValue": 30
      },
      {
        "key": "maxItems",
        "type": "integer",
        "label": "Maximum notifications",
        "min": 50,
        "max": 10000,
        "step": 50,
        "defaultValue": 1000
      },
      {
        "key": "clickAction",
        "type": "enum",
        "label": "When clicking a notification",
        "options": [
          "Auto",
          "Focus the app",
          "Nothing"
        ],
        "defaultValue": "Auto"
      },
      {
        "key": "showBody",
        "type": "boolean",
        "label": "Show message text",
        "defaultValue": true
      },
      {
        "key": "showPreview",
        "type": "boolean",
        "label": "Show images",
        "defaultValue": true
      },
      {
        "key": "panelWidth",
        "type": "integer",
        "label": "Panel width",
        "min": 320,
        "max": 900,
        "step": 20,
        "defaultValue": 420
      },
      {
        "key": "listHeight",
        "type": "integer",
        "label": "Maximum list height",
        "min": 0,
        "max": 1200,
        "step": 20,
        "defaultValue": 0
      },
      {
        "key": "collapsed",
        "type": "boolean",
        "label": "Start with collapsed groups",
        "defaultValue": true,
        "description": "One stacked card per application. Expand it to reveal the group heading and all messages."
      }
    ]
  }
}
